# Cloudflare headers — https://developers.cloudflare.com/pages/configuration/headers/

# Security baseline (web-baseline, 2026-07-24) — applied to every response.
# NO frame denial on purpose: /embed/onramp is intentionally iframed cross-origin by
# CyrusGate (cyrusgate/site/index.html) — X-Frame-Options / frame-ancestors 'self' would
# break that embed. Add frame-ancestors only with the real embedder host listed.
/*
  Strict-Transport-Security: max-age=15552000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), autoplay=*, fullscreen=self
  Content-Security-Policy: upgrade-insecure-requests

# Vite content-hashed assets are immutable (filename changes on content change) → cache 1 year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static images/icons — long cache, revalidate opportunistically
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.ico
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800

# Crawler files — short cache so updates propagate fast
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
